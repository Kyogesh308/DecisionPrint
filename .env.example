# Environment: dev, test, or production
DP_ENV=dev
# Backend mode: fixture for demos, live for connected services
DP_BACKEND=fixture
DP_DATA_DIR=./data
DP_DB_PATH=./var/decisionprint.db
DP_CACHE_DIR=./var/cache
DP_LOG_LEVEL=INFO
# Hindsight memory service
DP_HINDSIGHT_BASE_URL=
DP_HINDSIGHT_API_KEY=
DP_HINDSIGHT_BANK_ID=northstar-org
# LLM provider
DP_LLM_PROVIDER=openai
DP_LLM_MODEL=gpt-4
DP_LLM_API_KEY=
